pragma solidity 0.8.28;

import {Test, console} from "forge-std/Test.sol";
import {AsterismRenderer} from "../src/AsterismRenderer.sol";
import {AsterismConfig} from "../script/AsterismConfig.sol";

/// Golden tests: the Solidity renderer must emit exactly the bytes of the TypeScript reference renderer
/// (web/src/lib/asterism). Fixtures are generated by web/test/fixtures.gen.test.ts.
contract RendererTest is Test {
    AsterismRenderer internal renderer;
    string internal golden;
    bytes32 internal seed;

    /// Conservative eth_call gas budget for free RPC tiers (public Robinhood RPC allows 50M).
    uint256 internal constant TOKEN_URI_GAS_LIMIT = 3_000_000;

    function setUp() public {
        renderer = AsterismConfig.deployRenderer();
        golden = vm.readFile("test/fixtures/golden.json");
        seed = vm.parseJsonBytes32(golden, ".seed");
    }

    function test_goldenCasesMatchReferenceByteForByte() public view {
        uint256 n = vm.parseJsonUint(golden, ".count");
        for (uint256 i; i < n; ++i) {
            string memory p = string(abi.encodePacked(".cases[", vm.toString(i), "]"));
            uint256 id = vm.parseJsonUint(golden, string(abi.encodePacked(p, ".id")));
            string memory name = vm.parseJsonString(golden, string(abi.encodePacked(p, ".name")));
            assertEq(renderer.svg(id, seed, name), vm.parseJsonString(golden, string(abi.encodePacked(p, ".svg"))));
            assertEq(renderer.tokenURI(id, seed, name), vm.parseJsonString(golden, string(abi.encodePacked(p, ".uri"))));
        }
        assertEq(renderer.unrevealedSvg(), vm.parseJsonString(golden, ".unrevealedSvg"));
        assertEq(renderer.unrevealedURI(7), vm.parseJsonString(golden, ".unrevealedUri7"));
    }

    function test_everyIdMatchesReferenceHashAndTier() public view {
        bytes memory hashes = vm.readFileBinary("test/fixtures/svg-hashes.bin");
        bytes memory tiers = vm.readFileBinary("test/fixtures/tiers.bin");
        assertEq(hashes.length, 2222 * 32);
        uint256[5] memory counts;
        for (uint256 id = 1; id <= 2222; ++id) {
            bytes32 expected;
            assembly {
                expected := mload(add(add(hashes, 32), mul(sub(id, 1), 32)))
            }
            assertEq(keccak256(bytes(renderer.svg(id, seed, ""))), expected);
            uint256 t = renderer.tierOf(id, seed);
            assertEq(t, uint8(tiers[id - 1]));
            counts[t] += 1;
        }
        uint256[5] memory want = AsterismConfig.tierCounts();
        for (uint256 t; t < 5; ++t) assertEq(counts[t], want[t]);
    }

    function testFuzz_tierCountsExactForAnySeed(bytes32 s) public view {
        uint256[5] memory counts;
        for (uint256 id = 1; id <= 2222; ++id) counts[renderer.tierOf(id, s)] += 1;
        uint256[5] memory want = AsterismConfig.tierCounts();
        for (uint256 t; t < 5; ++t) assertEq(counts[t], want[t]);
    }

    function test_tokenUriGasStaysUnderBudget() public view {
        uint256 worst;
        uint256 worstId;
        string memory longName = "Forty-eight bytes of name, measured twice! Ok?..";
        for (uint256 id = 1; id <= 2222; id += 3) {
            uint256 g = gasleft();
            renderer.tokenURI(id, seed, longName);
            uint256 used = g - gasleft();
            if (used > worst) (worst, worstId) = (used, id);
        }
        console.log("max tokenURI gas (every 3rd id, 48-byte name):", worst, "id", worstId);
        assertLt(worst, TOKEN_URI_GAS_LIMIT);
    }

    function test_svgUsesOnlySafeCharactersAndNoExternalReferences() public view {
        uint256 maxLen;
        for (uint256 id = 1; id <= 2222; id += 7) {
            bytes memory s = bytes(renderer.svg(id, seed, "Lantern over the quiet field"));
            if (s.length > maxLen) maxLen = s.length;
            for (uint256 i; i < s.length; ++i) {
                bytes1 c = s[i];
                bool ok = (c >= 0x30 && c <= 0x39) || (c >= 0x41 && c <= 0x5a) || (c >= 0x61 && c <= 0x7a) || c == 0x20
                    || c == 0x3c || c == 0x3e || c == 0x2f || c == 0x3d || c == 0x22 || c == 0x23 || c == 0x2e || c == 0x2c
                    || c == 0x3a || c == 0x2d || c == 0x21 || c == 0x3f || c == 0x27;
                assertTrue(ok, "unsafe character");
            }
        }
        console.log("max svg bytes (sampled):", maxLen);
        assertLt(maxLen, 8192);
    }

    function test_invalidNamesAreDropped() public view {
        string memory plain = renderer.svg(5, seed, "");
        assertEq(renderer.svg(5, seed, "<script>alert(1)</script>"), plain);
        assertEq(renderer.svg(5, seed, "this name is definitely longer than forty-eight bytes"), plain);
    }

    function _expectBad(uint256 supply, uint256[5] memory c, uint256[5] memory lo, uint256[5] memory hi) internal {
        try new AsterismRenderer(supply, c, lo, hi) returns (AsterismRenderer) {
            revert("deployment should have failed");
        } catch (bytes memory err) {
            assertEq(bytes4(err), AsterismRenderer.InvalidDistribution.selector);
        }
    }

    function test_constructorRejectsBadDistributions() public {
        uint256[5] memory c = AsterismConfig.tierCounts();
        uint256[5] memory lo = AsterismConfig.minStars();
        uint256[5] memory hi = AsterismConfig.maxStars();
        _expectBad(2221, c, lo, hi); // sum mismatch
        hi[4] = 17;
        _expectBad(2222, c, lo, hi); // too many stars
        hi[4] = 16;
        lo[0] = 7;
        _expectBad(2222, c, lo, hi); // min above max
        lo[0] = 5;
        c[4] = 0;
        c[3] = 122;
        _expectBad(2222, c, lo, hi); // empty tier
        c = [uint256(4000), 50, 30, 10, 7];
        _expectBad(4097, c, lo, hi); // domain above 4096
    }
}
