# Example values only. Copy to .env.local for local work; in production set these in Cloudflare Pages.
# Never put a private key, seed phrase or an RPC provider key into a NEXT_PUBLIC_ variable: those ship to every visitor.

# --- Build time, public (Cloudflare Pages: Settings > Environment variables) ---
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_SITE_URL=https://asterism.example
# Leave empty until an external audit report exists; the site then says "No external audit yet".
NEXT_PUBLIC_AUDIT_REPORT_URL=
# Leave unset: reads go through this site's /api/rpc function, which keeps the provider key server side.
# NEXT_PUBLIC_RPC_URL=/api/rpc

# --- Runtime, server only (Cloudflare Pages Functions: encrypted secrets or variables) ---
# Upstream JSON-RPC endpoint the /api/rpc proxy forwards to. May contain a provider key, so keep it a secret.
RPC_UPSTREAM_URL=https://rpc.mainnet.chain.robinhood.com
# Comma-separated project addresses (renderer, launcher, token, mirror, sink). eth_call and eth_getLogs are limited to these.
PROJECT_ADDRESSES=0x0000000000000000000000000000000000000001,0x0000000000000000000000000000000000000002
# Comma-separated ISO country codes that get the view-only interface. Decided with legal counsel; empty means none.
BLOCKED_COUNTRIES=
# Extra origins allowed to call /api/rpc besides the site itself (comma-separated). Usually empty.
ALLOWED_ORIGINS=
# Maximum block range for eth_getLogs (default 10000).
MAX_LOG_RANGE=10000
