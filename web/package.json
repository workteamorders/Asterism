{
  "name": "asterism-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "node scripts/prepare.mjs && next dev",
    "prebuild": "node scripts/prepare.mjs",
    "build": "next build",
    "typecheck": "node scripts/prepare.mjs && tsc --noEmit",
    "test": "vitest run",
    "contracts:gen": "node scripts/gen-contracts.mjs",
    "fixtures": "GEN_FIXTURES=1 vitest run test/fixtures.gen.test.ts",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "record:deployment": "node scripts/record-deployment.mjs",
    "copy:check": "node scripts/copy-check.mjs",
    "secrets:check": "node scripts/secrets-check.mjs",
    "postbuild": "node scripts/postbuild.mjs",
    "e2e:setup": "bash test/e2e/setup.sh",
    "e2e": "node test/e2e/run.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@tanstack/react-query": "5.107.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.17",
    "wagmi": "3.7.11"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
